# For fully reproducible/auditable builds, pin by digest:
#   FROM debian:bookworm@sha256:<digest>
# Left as a floating tag so `apt-get update` below keeps picking up base-image
# security updates; bump to a digest pin if reproducibility outweighs that.
FROM debian:bookworm AS build

ARG GO_VERSION=1.26.10
ARG TARGETARCH

RUN apt-get update && apt-get install -y \
    build-essential \
    debhelper \
    devscripts \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Download the Go toolchain to a file and verify it against a pinned SHA256
# before extracting. The toolchain compiles the shipped binaries, so an
# in-transit/mirror swap would taint every release. The checksums below are
# for GO_VERSION (from https://go.dev/dl/?mode=json) and must be updated with
# it; the build fails closed on a mismatch or an unpinned arch. (Fetching
# `go.dev/dl/<file>.sha256` doesn't work: it returns an HTML redirect page, so
# an earlier fetch-and-verify step silently skipped verification.) Pass
# --build-arg GO_SHA256=<hex> to override for another version.
ARG GO_SHA256=""
RUN set -eux; \
    url="https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz"; \
    sum="${GO_SHA256}"; \
    if [ -z "$sum" ]; then \
        case "${GO_VERSION}-${TARGETARCH}" in \
            1.26.10-amd64) sum=ccfe7ae822d2c2f41f4fe7c956199967a4dac22d0ee0d2b2bfdb440aab3b20c5 ;; \
            1.26.10-arm64) sum=3f4227ce7b206a513e794f1393adb473a07b46e94d18bd15d1c684bbb7319797 ;; \
            *) echo "ERROR: no pinned SHA256 for go${GO_VERSION} linux/${TARGETARCH}; pass --build-arg GO_SHA256=<hex>" >&2; exit 1 ;; \
        esac; \
    fi; \
    curl -fsSL "$url" -o /tmp/go.tgz; \
    echo "${sum}  /tmp/go.tgz" | sha256sum -c -; \
    tar -C /usr/local -xzf /tmp/go.tgz; \
    rm -f /tmp/go.tgz
ENV PATH="/usr/local/go/bin:${PATH}"

WORKDIR /build

COPY . .

ARG BEWITCH_VERSION
RUN if [ -n "${BEWITCH_VERSION}" ]; then echo "${BEWITCH_VERSION}" > VERSION; fi

RUN scripts/gen-changelog.sh

RUN make deb

# Build standalone tarball
RUN VERSION=$(cat VERSION) && \
    ARCH=$(dpkg --print-architecture) && \
    mkdir -p /tarball/bewitch-${VERSION}-linux-${ARCH} && \
    cp bin/bewitchd bin/bewitch /tarball/bewitch-${VERSION}-linux-${ARCH}/ && \
    cp bewitch.example.toml /tarball/bewitch-${VERSION}-linux-${ARCH}/ && \
    cp debian/bewitch.bewitchd.service /tarball/bewitch-${VERSION}-linux-${ARCH}/bewitchd.service && \
    cp debian/bewitch.bewitch-smart.service /tarball/bewitch-${VERSION}-linux-${ARCH}/bewitch-smart.service && \
    cp debian/bewitch.bewitch-smart.timer /tarball/bewitch-${VERSION}-linux-${ARCH}/bewitch-smart.timer && \
    tar -czf /bewitch-${VERSION}-linux-${ARCH}.tar.gz \
        -C /tarball bewitch-${VERSION}-linux-${ARCH}

# Output stage - copy artifacts to /out
FROM scratch
COPY --from=0 /bewitch_*.deb /
COPY --from=0 /bewitch_*.buildinfo /
COPY --from=0 /bewitch_*.changes /
COPY --from=0 /bewitch-*.tar.gz /
